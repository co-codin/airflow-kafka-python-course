# Copy to .env and adjust if needed:
#   cp .env.example .env
#
# These values are local-dev defaults only. Do not reuse them in production.

# Host UID that owns mounted volumes (Linux). macOS/Windows can leave 50000.
AIRFLOW_UID=50000

# Official Airflow 3 image. Override if you need a different patch release.
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1

# Airflow UI login (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Local-only signing keys. Replace before exposing the stack beyond localhost.
AIRFLOW__API_AUTH__JWT_SECRET=course-local-jwt-secret-change-me
FERNET_KEY=

# Extra Python packages installed at container start (prefer the Dockerfile).
_PIP_ADDITIONAL_REQUIREMENTS=

# Kafka / Redpanda as seen from Airflow containers.
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=orders
